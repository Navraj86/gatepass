NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
DATABASE_URL=postgres://gatepass:gatepass@localhost:5432/gatepass
DB_POOL_MAX=10
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Lets tests and scripts act as any user with an x-user-id header. Never in production.
DEV_AUTH=false
LOG_LEVEL=info

# Dodo Payments test mode (dashboard: Developer > API keys / Webhooks)
DODO_PAYMENTS_API_KEY=
DODO_PRODUCT_ID=pdt_...
DODO_PAYMENTS_WEBHOOK_KEY=whsec_...
DODO_ENVIRONMENT=test_mode

# Ticket email (Resend). Without a key, emails are only logged.
RESEND_API_KEY=
EMAIL_FROM=Gatepass <tickets@mail.example.com>
