# Copy to ~/gatepass/.env on the server (chmod 600). compose.prod.yaml reads it.
# Generate secrets with: openssl rand -base64 48

POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
APP_URL=https://gatepass.navraj.dev
DB_POOL_MAX=20

# Dodo Payments test mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_ID=

# Ticket email (Resend). Without a key, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Gatepass <tickets@gatepass.navraj.dev>

# Grafana Cloud: stack details page, "Send metrics" and "Send logs"
GRAFANA_PROM_URL=
GRAFANA_PROM_USER=
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_CLOUD_TOKEN=

# Only for k6 runs: swaps Dodo session creation for a stub. Never leave on.
LOAD_TEST=false
