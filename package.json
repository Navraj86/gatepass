{
  "name": "gatepass",
  "private": true,
  "description": "Flash-sale ticketing with zero oversells, real test-mode payments and exactly-once check-in",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev:api": "pnpm --filter @gatepass/api dev",
    "dev:web": "pnpm --filter @gatepass/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @gatepass/api test",
    "build": "pnpm -r build"
  }
}
